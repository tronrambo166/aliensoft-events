{
  "info": {
    "_postman_id": "9b5d2e7a-7f9c-4b18-ae1f-ticket-tier-api",
    "name": "Ticket Tier API",
    "description": "Postman collection for Ticket Tier assessment API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "event_id",
      "value": "1"
    },
    {
      "key": "ticket_tier_id",
      "value": "1"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Ticket Tiers",
      "item": [
        {
          "name": "List Ticket Tiers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ticket-tiers?filter[event_id]={{event_id}}&include=event&sort=-created_at",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ticket-tiers"
              ]
            }
          }
        },
        {
          "name": "Filter By Channel",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ticket-tiers?filter[channel]=web",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ticket-tiers"
              ]
            }
          }
        },
        {
          "name": "Create Ticket Tier",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"event_id\": {{event_id}},\n    \"name\": \"VIP\",\n    \"price\": 100,\n    \"quantity\": 50,\n    \"sales_channels\": [\"web\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/ticket-tiers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ticket-tiers"
              ]
            }
          }
        },
        {
          "name": "Show Ticket Tier",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ticket-tiers/{{ticket_tier_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ticket-tiers",
                "{{ticket_tier_id}}"
              ]
            }
          }
        },
        {
          "name": "Update Ticket Tier",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"price\": 150\n}"
            },
            "url": {
              "raw": "{{base_url}}/ticket-tiers/{{ticket_tier_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ticket-tiers",
                "{{ticket_tier_id}}"
              ]
            }
          }
        },
        {
          "name": "Publish Ticket Tier",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ticket-tiers/{{ticket_tier_id}}/publish",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ticket-tiers",
                "{{ticket_tier_id}}",
                "publish"
              ]
            }
          }
        },
        {
          "name": "Delete Ticket Tier",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ticket-tiers/{{ticket_tier_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ticket-tiers",
                "{{ticket_tier_id}}"
              ]
            }
          }
        }
      ]
    }
  ]
}